    {
      "name": "account",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"account\" (\"id\" TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36), \"name\" TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 60), \"type\" TEXT NOT NULL CHECK (type IN ('cash', 'card', 'bank', 'deposit', 'credit', 'other')), \"currency\" TEXT NOT NULL CHECK (length(currency) = 3 AND currency = upper(currency)), \"opening_balance_minor\" INTEGER NOT NULL DEFAULT 0, \"budget_mode\" TEXT NOT NULL DEFAULT 'on_budget' CHECK (budget_mode IN ('on_budget', 'tracking')), \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (hidden IN (0, 1)), \"archived_at\" INTEGER, \"color_index\" INTEGER NOT NULL CHECK (color_index BETWEEN 0 AND 6), \"icon\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER);"
        }
      ]
    },
    {
      "name": "account_archived_sort",
      "sql": [
        {
