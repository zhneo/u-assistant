        "name": "category_parent_insert",
        "sql": "CREATE TRIGGER category_parent_insert\nBEFORE INSERT ON category\nWHEN NEW.parent_id IS NOT NULL\nBEGIN\n  SELECT RAISE(ABORT, 'category_parent_invalid')\n  WHERE NOT EXISTS (\n    SELECT 1 FROM category p\n    WHERE p.id = NEW.parent_id AND p.parent_id IS NULL AND p.kind = NEW.kind\n  );\nEND;"
      }
