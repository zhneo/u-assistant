          "sql": "CREATE INDEX account_archived_sort ON account (archived_at, sort_order)"
        }
      ]
    },
    {
      "name": "category",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category\" (\"id\" TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36), \"kind\" TEXT NOT NULL CHECK (kind IN ('expense', 'income')), \"parent_id\" TEXT REFERENCES category(id)ON DELETE RESTRICT, \"name\" TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 40), \"icon\" TEXT NOT NULL, \"color_index\" INTEGER NOT NULL CHECK (color_index BETWEEN 0 AND 6), \"sort_order\" INTEGER NOT NULL, \"default_key\" TEXT UNIQUE, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (hidden IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER);"
        }
      ]
    },
    {
      "name": "fin_transaction",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fin_transaction\" (\"id\" TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36), \"kind\" TEXT NOT NULL CHECK (kind IN ('expense', 'income', 'transfer_out', 'transfer_in', 'adjustment', 'debt_out', 'debt_in')), \"status\" TEXT NOT NULL DEFAULT 'posted' CHECK (status IN ('posted', 'planned')), \"account_id\" TEXT NOT NULL REFERENCES account(id)ON DELETE RESTRICT, \"category_id\" TEXT REFERENCES category(id)ON DELETE RESTRICT, \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL CHECK (length(currency) = 3), \"rate_to_base\" TEXT, \"amount_base_minor\" INTEGER, \"report_effect\" TEXT NOT NULL CHECK (report_effect IN ('expense', 'income', 'none')), \"is_refund\" INTEGER NOT NULL DEFAULT 0 CHECK (is_refund IN (0, 1)), \"date\" TEXT NOT NULL CHECK (date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), \"time\" TEXT CHECK (time IS NULL OR time GLOB '[0-2][0-9]:[0-5][0-9]'), \"note\" TEXT CHECK (note IS NULL OR length(note) <= 500), \"transfer_group_id\" TEXT, \"debt_id\" TEXT, \"recurring_payment_id\" TEXT, \"voice_session_id\" TEXT, \"import_batch_id\" TEXT, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER, CHECK(kind NOT IN ('expense', 'income') OR category_id IS NOT NULL), CHECK(kind = 'adjustment' OR amount_minor >= 0), CHECK(kind NOT IN ('transfer_out', 'transfer_in') OR transfer_group_id IS NOT NULL), CHECK(kind NOT IN ('debt_out', 'debt_in') OR debt_id IS NOT NULL), CHECK((kind = 'expense' AND report_effect = 'expense')OR(kind = 'income' AND report_effect = 'income')OR(kind IN ('adjustment', 'debt_out', 'debt_in') AND report_effect = 'none')OR kind IN ('transfer_out', 'transfer_in')), CHECK(report_effect = 'none' OR category_id IS NOT NULL), CHECK(status = 'posted' OR recurring_payment_id IS NOT NULL OR kind IN ('expense', 'income', 'transfer_out', 'transfer_in')));"
        }
      ]
    },
