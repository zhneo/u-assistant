-- Таблицы модуля «Деньги» (DATABASE §4.2–4.5, D-058).
-- Служебные колонки: created_at / updated_at / deleted_at — миллисекунды UTC; даты — 'YYYY-MM-DD'.

CREATE TABLE account (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  name TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 60),
  type TEXT NOT NULL CHECK (type IN ('cash', 'card', 'bank', 'deposit', 'credit', 'other')),
  currency TEXT NOT NULL CHECK (length(currency) = 3 AND currency = upper(currency)),
  opening_balance_minor INTEGER NOT NULL DEFAULT 0,
  budget_mode TEXT NOT NULL DEFAULT 'on_budget' CHECK (budget_mode IN ('on_budget', 'tracking')),
  hidden INTEGER NOT NULL DEFAULT 0 CHECK (hidden IN (0, 1)),
  archived_at INTEGER,
  color_index INTEGER NOT NULL CHECK (color_index BETWEEN 0 AND 6),
  icon TEXT NOT NULL,
  sort_order INTEGER NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER
) AS AccountRow;

CREATE INDEX account_archived_sort ON account (archived_at, sort_order);

-- I4 / FR-FIN-03: валюту счёта с операциями изменить нельзя.
CREATE TRIGGER account_currency_locked
BEFORE UPDATE OF currency ON account
WHEN OLD.currency <> NEW.currency
  AND EXISTS (SELECT 1 FROM fin_transaction t WHERE t.account_id = OLD.id)
BEGIN
  SELECT RAISE(ABORT, 'account_currency_locked');
END;

CREATE TABLE category (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  kind TEXT NOT NULL CHECK (kind IN ('expense', 'income')),
  parent_id TEXT REFERENCES category (id) ON DELETE RESTRICT,
  name TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 40),
  icon TEXT NOT NULL,
  color_index INTEGER NOT NULL CHECK (color_index BETWEEN 0 AND 6),
  sort_order INTEGER NOT NULL,
  default_key TEXT UNIQUE,
  hidden INTEGER NOT NULL DEFAULT 0 CHECK (hidden IN (0, 1)),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER
) AS CategoryRow;

CREATE UNIQUE INDEX category_name_unique
  ON category (kind, ifnull(parent_id, ''), name COLLATE NOCASE)
  WHERE deleted_at IS NULL;
CREATE INDEX category_parent ON category (parent_id);

-- I10: родитель — верхнего уровня и того же типа (не больше двух уровней).
CREATE TRIGGER category_parent_insert
BEFORE INSERT ON category
WHEN NEW.parent_id IS NOT NULL
BEGIN
  SELECT RAISE(ABORT, 'category_parent_invalid')
  WHERE NOT EXISTS (
    SELECT 1 FROM category p
    WHERE p.id = NEW.parent_id AND p.parent_id IS NULL AND p.kind = NEW.kind
  );
END;

CREATE TRIGGER category_parent_update
BEFORE UPDATE OF parent_id, kind ON category
WHEN NEW.parent_id IS NOT NULL
BEGIN
  SELECT RAISE(ABORT, 'category_parent_invalid')
  WHERE NOT EXISTS (
    SELECT 1 FROM category p
    WHERE p.id = NEW.parent_id AND p.parent_id IS NULL AND p.kind = NEW.kind
  );
END;

CREATE TABLE exchange_rate (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  currency TEXT NOT NULL CHECK (length(currency) = 3),
  base_currency TEXT NOT NULL CHECK (length(base_currency) = 3),
  rate TEXT NOT NULL CHECK (CAST(rate AS REAL) > 0),
  valid_from TEXT NOT NULL CHECK (valid_from GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,
  CHECK (currency <> base_currency)
) AS ExchangeRateRow;

CREATE UNIQUE INDEX exchange_rate_unique
  ON exchange_rate (currency, base_currency, valid_from)
  WHERE deleted_at IS NULL;

CREATE TABLE fin_transaction (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  kind TEXT NOT NULL CHECK (kind IN ('expense', 'income', 'transfer_out', 'transfer_in', 'adjustment', 'debt_out', 'debt_in')),
  status TEXT NOT NULL DEFAULT 'posted' CHECK (status IN ('posted', 'planned')),
  account_id TEXT NOT NULL REFERENCES account (id) ON DELETE RESTRICT,
  category_id TEXT REFERENCES category (id) ON DELETE RESTRICT,
  amount_minor INTEGER NOT NULL,
  currency TEXT NOT NULL CHECK (length(currency) = 3),
  rate_to_base TEXT,
  amount_base_minor INTEGER,
  report_effect TEXT NOT NULL CHECK (report_effect IN ('expense', 'income', 'none')),
  is_refund INTEGER NOT NULL DEFAULT 0 CHECK (is_refund IN (0, 1)),
  date TEXT NOT NULL CHECK (date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),
  time TEXT CHECK (time IS NULL OR time GLOB '[0-2][0-9]:[0-5][0-9]'),
  note TEXT CHECK (note IS NULL OR length(note) <= 500),
  transfer_group_id TEXT,
  -- Внешние ключи добавляются вместе с таблицами-владельцами (D-062).
  debt_id TEXT,
  recurring_payment_id TEXT,
  voice_session_id TEXT,
  import_batch_id TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,
  CHECK (kind NOT IN ('expense', 'income') OR category_id IS NOT NULL),
  CHECK (kind = 'adjustment' OR amount_minor >= 0),
  CHECK (kind NOT IN ('transfer_out', 'transfer_in') OR transfer_group_id IS NOT NULL),
  CHECK (kind NOT IN ('debt_out', 'debt_in') OR debt_id IS NOT NULL),
  CHECK (
    (kind = 'expense' AND report_effect = 'expense')
    OR (kind = 'income' AND report_effect = 'income')
    OR (kind IN ('adjustment', 'debt_out', 'debt_in') AND report_effect = 'none')
    OR kind IN ('transfer_out', 'transfer_in')
  ),
  -- Перевод, который входит в отчёты, обязан иметь категорию (§5.2).
  CHECK (report_effect = 'none' OR category_id IS NOT NULL),
  CHECK (
    status = 'posted'
    OR recurring_payment_id IS NOT NULL
    OR kind IN ('expense', 'income', 'transfer_out', 'transfer_in')
  )
) AS FinTransactionRow;

-- I1: в паре перевода ровно один out и один in.
CREATE UNIQUE INDEX fin_transaction_transfer_pair
  ON fin_transaction (transfer_group_id, kind)
  WHERE transfer_group_id IS NOT NULL AND deleted_at IS NULL;
-- I12: правило не создаёт двух плановых операций на один день.
CREATE UNIQUE INDEX fin_transaction_planned_unique
  ON fin_transaction (recurring_payment_id, date)
  WHERE status = 'planned' AND deleted_at IS NULL;

CREATE INDEX fin_transaction_status_date ON fin_transaction (status, date);
CREATE INDEX fin_transaction_account_date ON fin_transaction (account_id, date);
CREATE INDEX fin_transaction_category_date ON fin_transaction (category_id, date)
  WHERE report_effect <> 'none';
CREATE INDEX fin_transaction_transfer_group ON fin_transaction (transfer_group_id);
CREATE INDEX fin_transaction_debt ON fin_transaction (debt_id);
CREATE INDEX fin_transaction_recurring ON fin_transaction (recurring_payment_id, status, date);
CREATE INDEX fin_transaction_import ON fin_transaction (import_batch_id);
CREATE INDEX fin_transaction_voice ON fin_transaction (voice_session_id);

-- I3: валюта операции = валюта счёта.
CREATE TRIGGER fin_transaction_currency_insert
BEFORE INSERT ON fin_transaction
BEGIN
  SELECT RAISE(ABORT, 'transaction_currency_mismatch')
  WHERE NEW.currency <> (SELECT a.currency FROM account a WHERE a.id = NEW.account_id);
END;

CREATE TRIGGER fin_transaction_currency_update
BEFORE UPDATE OF currency, account_id ON fin_transaction
BEGIN
  SELECT RAISE(ABORT, 'transaction_currency_mismatch')
  WHERE NEW.currency <> (SELECT a.currency FROM account a WHERE a.id = NEW.account_id);
END;

-- Тип категории соответствует операции: расход, возврат и перевод-расход — категория
-- расходов; доход и перевод-доход — категория доходов (DATABASE §4.5).
CREATE TRIGGER fin_transaction_category_kind_insert
BEFORE INSERT ON fin_transaction
WHEN NEW.category_id IS NOT NULL
BEGIN
  SELECT RAISE(ABORT, 'category_kind_mismatch')
  WHERE (SELECT c.kind FROM category c WHERE c.id = NEW.category_id) <>
    CASE
      WHEN NEW.kind = 'expense' OR NEW.is_refund = 1 OR NEW.report_effect = 'expense' THEN 'expense'
      ELSE 'income'
    END;
END;

CREATE TRIGGER fin_transaction_category_kind_update
BEFORE UPDATE OF category_id, kind, is_refund, report_effect ON fin_transaction
WHEN NEW.category_id IS NOT NULL
BEGIN
  SELECT RAISE(ABORT, 'category_kind_mismatch')
  WHERE (SELECT c.kind FROM category c WHERE c.id = NEW.category_id) <>
    CASE
      WHEN NEW.kind = 'expense' OR NEW.is_refund = 1 OR NEW.report_effect = 'expense' THEN 'expense'
      ELSE 'income'
    END;
END;

-- Счета с балансом (REQUIREMENTS §6.2). Эталон формулы — accountBalance в core (D-060).
activeAccountsWithBalance:
SELECT a.**,
  a.opening_balance_minor + COALESCE((
    SELECT SUM(CASE
      WHEN t.kind IN ('income', 'transfer_in', 'debt_in', 'adjustment') THEN t.amount_minor
      ELSE -t.amount_minor
    END)
    FROM fin_transaction t
    WHERE t.account_id = a.id AND t.status = 'posted' AND t.deleted_at IS NULL
  ), 0) AS balance_minor
FROM account a
WHERE a.deleted_at IS NULL AND a.archived_at IS NULL
ORDER BY a.sort_order, a.created_at;
